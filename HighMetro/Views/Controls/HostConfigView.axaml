<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="450"
             x:Class="HighMetro.Views.Controls.HostConfigView"
             x:Name="Root">
    <Border BorderBrush="Black" 
            BorderThickness="1" 
            CornerRadius="1"
            Padding="2">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="5" 
          DataContext="{Binding HostConfigViewModelVm, ElementName=Root}">
        <!-- 第一行：同一行横向排列：标题｜红色提示框｜消息栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
            <!-- 固定标题 -->
            <TextBlock Grid.Column="0" Text="{Binding HostState}" 
                       VerticalAlignment="Center" FontWeight="Bold"/>

            <!-- 消息栏：接收消息提示 -->
            <TextBlock Grid.Column="1" Text="{Binding MessageText}" 
                       Foreground="ForestGreen" VerticalAlignment="Center" 
                       TextAlignment="Left" TextWrapping="NoWrap"/>
        </Grid>
        <!-- 第二行：输入框 + 按钮 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,6,120,
                         12,Auto,6,100,
                         12,Auto,6,120,
                         12,Auto,6,180,
                         12,Auto,6,Auto" 
              VerticalAlignment="Center">
            <TextBlock Grid.Column="0"  Text="IP：" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2"  Text="{Binding Ip}" 
                     IsReadOnly="{Binding IsReadOnly}" Watermark="请输入IP地址"/>

            <TextBlock Grid.Column="4"  Text="端口：" VerticalAlignment="Center"/>
            <TextBox Grid.Column="6"  Text="{Binding Port}" 
                     IsReadOnly="{Binding IsReadOnly}" Watermark="端口号"/>

            <TextBlock Grid.Column="8"  Text="Code：" VerticalAlignment="Center"/>
            <TextBox Grid.Column="10" Text="{Binding Code}" 
                     IsReadOnly="{Binding IsReadOnly}" Watermark="设备编码"/>

            <TextBlock Grid.Column="12" Text="名称：" VerticalAlignment="Center"/>
            <TextBox Grid.Column="14" Text="{Binding Name}" 
                     IsReadOnly="{Binding IsReadOnly}" Watermark="设备名称"/>

            <Button Grid.Column="16" Content="监听" Command="{Binding OpenCommand}" 
                    Width="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="18" Content="关闭" Command="{Binding CloseCommand}" 
                    Width="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
    </Border>
</UserControl>
