<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HighMetro.Views.Controls.CameraPreviewView"
             Width="1020" Height="600">
    <Border Background="White" Padding="24" CornerRadius="8">
        <StackPanel Spacing="12">
            <TextBlock Text="摄像头调试" FontSize="18" FontWeight="Bold" Height="30"/>
            <Grid RowDefinitions="30,30,*" RowSpacing="8">
                <!-- 第一行：连接状态文字 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding CamState}"
                               VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding MessageText}"
                               Foreground="ForestGreen" VerticalAlignment="Center"
                               TextAlignment="Left" TextWrapping="NoWrap"/>
                </Grid>
                <!-- 第二行：IP/端口/用户名 + 按钮 -->
                <Grid Grid.Row="1" ColumnSpacing="4"
                      ColumnDefinitions="200,240,240,16,*"
                      VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="IP地址：" Width="60" VerticalAlignment="Center"
                                   TextAlignment="Right"/>
                        <TextBox Text="{Binding Ip}" Width="140" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="端口：" Width="80" VerticalAlignment="Center"
                                   TextAlignment="Right"/>
                        <TextBox Text="{Binding Port}" Width="160" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="用户名：" Width="80" VerticalAlignment="Center"
                                   TextAlignment="Right"/>
                        <TextBox Text="{Binding UserName}" Width="160" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                        <Button Content="启动" Command="{Binding OpenCommand}" Width="60"/>
                        <Button Content="抓拍" Command="{Binding SnapCommand}" Width="60"/>
                        <Button Content="关闭" Command="{Binding CloseCommand}" Width="60"/>
                        <Button Content="退出" Command="{Binding ExitCommand}" Width="60"/>
                    </StackPanel>
                </Grid>

                <!-- ========== 第三行：左右严格1:1等分，带边框区分 ========== -->
                <Grid Grid.Row="2" 
                      Height="410"
                      Background="#111111" 
                      ColumnDefinitions="*,*" 
                      ColumnSpacing="6">
                    <!-- 左：实时预览 -->
                    <Grid Grid.Column="0" Background="#0A0A0A" >
                        <Image Source="{Binding PreviewSource}"
                               Stretch="Uniform" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#cccccc"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsNoVideo}"/>
                        <Border Background="#CC000000" Padding="4 2" 
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="实时预览" Foreground="White" 
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- 右：抓拍图片 -->
                    <Grid Grid.Column="1" Background="#0A0A0A" >
                        <Image Source="{Binding SnapshotSource}"
                               Stretch="Uniform" />
                        <TextBlock Text="{Binding SnapshotTip}"
                                   Foreground="#cccccc"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsNoSnapshot}"/>
                        <Border Background="#CC000000" Padding="4 2" 
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="抓拍图片" Foreground="White" 
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
