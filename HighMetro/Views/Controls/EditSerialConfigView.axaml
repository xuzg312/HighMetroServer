<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HighMetro.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="480" Height="460"
        WindowStartupLocation="CenterOwner"
        x:Class="HighMetro.Views.Controls.EditSerialConfigView"
        Title="串口参数配置">
        <StackPanel Margin="24" Spacing="12">
                <controls:SerialConfigView
                        Config="{Binding Config}"
                        IsReadOnly="False"/>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                        <Button Content="测试打开串口" Command="{Binding TestOpenPortCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
                        <Button Content="保存" Command="{Binding SaveCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="取消" Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
        </StackPanel>
</Window>
