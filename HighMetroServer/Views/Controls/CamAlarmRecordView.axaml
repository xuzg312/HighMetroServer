<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HighMetroServer.Views.Controls.CamAlarmRecordView"
             Width="1070" Height="600">
    <Border Background="White" Padding="24" CornerRadius="8">
        <!-- ❗把StackPanel改成Grid，分配剩余空间，Spacing换成Margin -->
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <!-- 上面整块查询区域 -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="10">
                <Border Grid.Row="0" BorderThickness="1" BorderBrush="#cccccc" 
                        Padding="10" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="拍照记录" FontSize="18" FontWeight="Bold" Height="30"/>
                        <TextBlock Text="{Binding MessageText}"  Height="30"
                            Foreground="ForestGreen" VerticalAlignment="Center" 
                            TextAlignment="Left" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#cccccc" Padding="10" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="查询日期:" VerticalAlignment="Center"/>
                        <CalendarDatePicker 
                            SelectedDate="{Binding QueryDate}"
                            CustomDateFormatString="yyyy-MM-dd"
                            Width="160"/>
                        <Button Content="查询" Command="{Binding QueryCommand}" Width="80"/>
                        <Button Content="浏览" Command="{Binding BrowseCommand}" Width="80"/>
                        <Button Content="退出" Command="{Binding ExitCommand}" Width="80" />
                    </StackPanel>
                </Border>
                <!-- 这一行*现在真正生效，给DataGrid区域 -->
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="#cccccc" Padding="6" CornerRadius="6">
                    <DataGrid ItemsSource="{Binding RecordList}"
                              SelectedItem="{Binding SelectedRow}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              VerticalAlignment="Stretch"
                              HeadersVisibility="All"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="门" Binding="{Binding Door}" Width="100"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="触发时间" Binding="{Binding DateTime}" Width="190"/>
                            <DataGridTextColumn Header="次数" Binding="{Binding Serial}" Width="70"/>
                            <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="120"/>
                            <DataGridTextColumn Header="上传标志" Binding="{Binding Upload}" Width="90"/>
                            <DataGridTextColumn Header="上传时间" Binding="{Binding UploadDateTime}" Width="190"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Row="3" BorderThickness="1" BorderBrush="#cccccc" Padding="10" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Width="80" Height="32"/>
                        <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"/>
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Width="80" Height="32"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 占位，Grid.Row="1" 是*，留给上面内层Grid剩余空间 -->
            <Grid Grid.Row="1"/>
        </Grid>
    </Border>
</UserControl>
